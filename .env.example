# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional external backend API base URL.
# Leave empty to use the built-in same-origin /api/v1 Express backend.
VITE_API_BASE_URL=""

# FORM_BUILDER_ADMIN_USERNAME & FORM_BUILDER_INITIAL_PASSWORD:
# Server-side initial administrator credentials provisioned once when no platform_admin exists.
# Must be rotated on first login via the mandatory Credential Setup screen.
FORM_BUILDER_ADMIN_USERNAME=""
FORM_BUILDER_INITIAL_PASSWORD=""

# DATABASE_PATH: SQLite database file location (defaults to ./data/savanna.db)
DATABASE_PATH="data/savanna.db"

# UPLOAD_DIR: Private directory for candidate document uploads (defaults to ./uploads)
UPLOAD_DIR="uploads"

# CORS_ALLOWED_ORIGINS: Optional comma-separated list of external origins allowed for credentialed API requests
CORS_ALLOWED_ORIGINS=""

# SMS_WEBHOOK_URL: Optional outbound SMS relay webhook URL for resume links
SMS_WEBHOOK_URL=""

